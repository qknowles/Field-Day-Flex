

import React, { useState, useEffect } from 'react';
import { getEntryDetailsByID } from '../utils/firestore';
import { useAtomValue } from 'jotai';
import { currentUserEmail, currentProjectName, currentTableName } from '../utils/jotai.js';
import Button from './Button';

/**
 * Component to display matching history entries that were found based on ID domain fields
 */
const HistoryLookup = ({ matchingIDs, onSelectEntry, isLoading = false }) => {
  const [selectedEntryID, setSelectedEntryID] = useState(null);
  const [entryDetails, setEntryDetails] = useState(null);
  const [isExpanded, setIsExpanded] = useState(false);
  
  const email = useAtomValue(currentUserEmail);
  const projectName = useAtomValue(currentProjectName);
  const tabName = useAtomValue(currentTableName);
  
  useEffect(() => {
    // Reset component when matchingIDs changes
    setSelectedEntryID(null);
    setEntryDetails(null);
    setIsExpanded(matchingIDs && matchingIDs.length > 0);
  }, [matchingIDs]);
  
  useEffect(() => {
    const fetchEntryDetails = async () => {
      if (selectedEntryID) {
        try {
          const details = await getEntryDetailsByID(email, projectName, tabName, selectedEntryID);
          setEntryDetails(details);
        } catch (error) {
          console.error("Error fetching entry details:", error);
          setEntryDetails(null);
        }
      } else {
        setEntryDetails(null);
      }
    };
    
    fetchEntryDetails();
  }, [selectedEntryID, email, projectName, tabName]);
  
  if (isLoading) {
    return (
      <div className="p-3 bg-blue-100 dark:bg-blue-900 rounded-md">
        <p className="text-center text-blue-700 dark:text-blue-300">
          <span className="inline-block animate-pulse">⏳</span> Checking entry history...
        </p>
      </div>
    );
  }
  
  if (!matchingIDs || matchingIDs.length === 0) return null;
  
  return (
    <div className="p-4 border border-yellow-300 bg-yellow-50 dark:bg-yellow-900/30 dark:border-yellow-700 rounded-md">
      <div className="flex justify-between items-center">
        <h3 className="font-bold text-yellow-800 dark:text-yellow-300">
          {matchingIDs.length} Previous {matchingIDs.length === 1 ? 'Entry' : 'Entries'} Found
        </h3>
        <button 
          onClick={() => setIsExpanded(!isExpanded)}
          className="text-yellow-600 dark:text-yellow-400 hover:text-yellow-800 dark:hover:text-yellow-200"
        >
          {isExpanded ? 'Hide' : 'Show'}
        </button>
      </div>
      
      {isExpanded && (
        <div className="mt-3">
          <p className="text-sm text-yellow-700 dark:text-yellow-400 mb-2">
            These entries have matching identifier values:
          </p>
          
          <div className="space-y-2">
            {matchingIDs.map((id) => (
              <div 
                key={id} 
                className={`p-2 border rounded cursor-pointer transition-colors ${
                  selectedEntryID === id 
                    ? 'bg-yellow-200 dark:bg-yellow-800 border-yellow-500 dark:border-yellow-600' 
                    : 'bg-yellow-100 dark:bg-yellow-900/50 border-yellow-300 dark:border-yellow-800 hover:bg-yellow-200 dark:hover:bg-yellow-800/70'
                }`}
                onClick={() => setSelectedEntryID(id === selectedEntryID ? null : id)}
              >
                <p className="font-medium">{id}</p>
              </div>
            ))}
          </div>
          
          {selectedEntryID && entryDetails && (
            <div className="mt-4 p-3 bg-white dark:bg-neutral-800 rounded border border-yellow-300 dark:border-yellow-700">
              <h4 className="font-bold mb-2">Entry Details ({selectedEntryID})</h4>
              <div className="space-y-1 text-sm max-h-48 overflow-y-auto">
                {Object.entries(entryDetails.entry_data || {}).map(([key, value]) => (
                  <div key={key} className="grid grid-cols-2 gap-2">
                    <span className="font-medium">{key}:</span>
                    <span>{value !== null && value !== undefined ? String(value) : 'N/A'}</span>
                  </div>
                ))}
              </div>
              
              <div className="mt-4 flex justify-end">
                <Button 
                  text="Use This Entry's ID" 
                  onClick={() => onSelectEntry(selectedEntryID)} 
                  className="text-sm"
                />
              </div>
            </div>
          )}
        </div>
      )}
    </div>
  );
};

export default HistoryLookup;